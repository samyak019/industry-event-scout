# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployment.
# Placeholders only — never commit real values.

# Supabase (server uses the service-role key; RLS blocks the anon key entirely)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (server-side only). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to Google's "gemini-flash-latest" alias; pin a specific Flash model if preferred.
GEMINI_MODEL=gemini-flash-latest

# Tavily web search (server-side only). Free tier: https://app.tavily.com
TAVILY_API_KEY=

# Optional Eventbrite adapter (organiser event lists only; public search API no longer exists)
EVENTBRITE_API_TOKEN=
EVENTBRITE_ORGANIZER_IDS=

# Resend (server-side only). RESEND_FROM_EMAIL must be on a domain verified in Resend,
# or "Event Scout <onboarding@resend.dev>" to send ONLY to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Event Scout <onboarding@resend.dev>
# Fallback recipient when no email is saved in Settings
DIGEST_TO_EMAIL=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Use a long random string.
CRON_SECRET=

# Password that unlocks Settings edits, "Refresh events" and "Send test email".
ADMIN_PASSWORD=

# Application settings
APP_URL=https://your-app.vercel.app
DEFAULT_TIMEZONE=Asia/Kolkata
